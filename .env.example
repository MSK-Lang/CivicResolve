# ==============================================================================
# CivicResolve Environment Variables Configuration (.env)
# GDG PSG iTech x H2S Hackathon
# NEVER COMMIT REAL KEYS TO SOURCE CONTROL
# ==============================================================================

# Server Network Configuration
NODE_ENV=development
PORT=3001
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:5173

# Google Gemini API
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Firebase Admin Configuration (Backend)
# In GCP Cloud Run, Application Default Credentials (ADC) are detected automatically.
# For local development with service account credentials:
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@your-firebase-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# Firebase Client Configuration (Frontend - packages/client)
# Exposed to client Vite build via VITE_ prefix
VITE_FIREBASE_API_KEY=your_client_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-firebase-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-firebase-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-firebase-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id
